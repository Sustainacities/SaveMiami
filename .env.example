# ============================================================
# SaveMiami — Open Data Hub & Digital Twin
# Copy this file to .env.local and fill in your values
# ============================================================

# Map base style (CARTO dark-matter is free, no key needed)
NEXT_PUBLIC_MAPLIBRE_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Optional: Mapbox token for satellite imagery layer
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── NVIDIA Inception Program ─────────────────────────────────
# NVIDIA Omniverse Nucleus endpoint for Digital Twin sync
NEXT_PUBLIC_NVIDIA_OMNIVERSE_ENDPOINT=
# NVIDIA Modulus / PhysX Cloud API key for physics simulation
NVIDIA_MODULUS_API_KEY=
# NVIDIA cuSPATIAL endpoint for GPU spatial analytics
NVIDIA_CUSPATIAL_ENDPOINT=
# NVIDIA Metropolis Video Analytics API
NVIDIA_METROPOLIS_API_KEY=

# ── EPA ───────────────────────────────────────────────────────
# EPA ECHO API (Enforcement & Compliance History Online)
NEXT_PUBLIC_EPA_API_KEY=
# EPA PFAS Analytics Tool endpoint
EPA_PFAS_ENDPOINT=https://pfas-iefa.epa.gov/api/v1

# ── FDEP (Florida DEP) ───────────────────────────────────────
FDEP_API_KEY=
FDEP_WASTE_SITES_URL=https://ca.dep.state.fl.us/mapdirect

# ── Miami-Dade Open Data ─────────────────────────────────────
NEXT_PUBLIC_MIAMI_DADE_OPEN_DATA_TOKEN=
MIAMI_DADE_SOCRATA_DOMAIN=opendata.miamidade.gov

# ── NOAA Wind / Weather ──────────────────────────────────────
NEXT_PUBLIC_NOAA_TOKEN=
NOAA_CDO_BASE_URL=https://www.ncdc.noaa.gov/cdo-web/api/v2

# ── 305 Consortium ───────────────────────────────────────────
CONSORTIUM_305_API_KEY=
CONSORTIUM_305_ENDPOINT=

# ── Water.org Blue Economy ───────────────────────────────────
WATER_ORG_API_KEY=

# ── Logos Capital Ecosystem ──────────────────────────────────
LOGOS_CAPITAL_API_KEY=
