# =============================================================
# AquaDome Core MVP — Environment Variables
# Copy to .env and fill in real values before running
# =============================================================

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aquadome:aquadome@db:5432/aquadome
POSTGRES_USER=aquadome
POSTGRES_PASSWORD=aquadome
POSTGRES_DB=aquadome

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── NATS ────────────────────────────────────────────────────
NATS_URL=nats://nats:4222

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_32_CHAR_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Map Tokens ──────────────────────────────────────────────
VITE_MAPBOX_TOKEN=your_mapbox_token_here
VITE_CESIUM_ION_TOKEN=your_cesium_ion_token_here

# ── TAK / CoT ───────────────────────────────────────────────
TAK_MULTICAST_GROUP=239.2.3.1
TAK_MULTICAST_PORT=6969
TAK_WEB_URL=wss://your-tak-server:8446/ws
TAK_WEB_CERT=

# ── Anduril Lattice ─────────────────────────────────────────
LATTICE_ENABLED=false
LATTICE_API_KEY=your_lattice_api_key
LATTICE_API_URL=https://api.lattice.anduril.com
LATTICE_ORG_ID=your_org_id
LATTICE_WEBHOOK_SECRET=your_webhook_shared_secret

# ── Hextronics ──────────────────────────────────────────────
HEXTRONICS_ENABLED=false
HEXTRONICS_BASE_URL=https://api.hextronics.com
HEXTRONICS_API_KEY=your_hextronics_api_key

# ── MiamiVerse ──────────────────────────────────────────────
MIAMIVERSE_ENABLED=false
MIAMIVERSE_API_URL=https://api.miamiverse.city
MIAMIVERSE_API_KEY=your_miamiverse_api_key

# ── Palantir Maven MSS (requires DoD CRADA) ─────────────────
MAVEN_CRADA_ENABLED=false
# MAVEN_API_URL=https://maven-api.palantir.com/v1
# MAVEN_API_KEY=classified_requires_crada

# ── Windward / AIS ──────────────────────────────────────────
WINDWARD_ENABLED=false
WINDWARD_API_KEY=your_windward_api_key

# ── DERM ArcGIS ─────────────────────────────────────────────
DERM_ENABLED=false
DERM_ARCGIS_URL=https://gis.miamidade.gov/arcgis/rest/services

# ── Live Data (no key required) ─────────────────────────────
USGS_GAUGE_URL=https://waterservices.usgs.gov/nwis/iv/
USGS_SITE=02288990
NOAA_STATION=8723170

# ── Simulation ──────────────────────────────────────────────
ISAAC_ENABLED=false
SIM_DEFAULT_SCENARIO=biscayne_patrol
SIM_TICK_HZ=1
SIM_SPEED_MULTIPLIER=1.0

# ── Misc ────────────────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:80
ENVIRONMENT=development
